{
  "description": "Link assertion cases for the Central verifier (docs/LINKING.md, Verification order). Tokens are built from contract-config.json baseHeader and baseAssertion, with the patches below applied (null deletes a member). expect is 'accepted' or the rejection code.",
  "cases": [
    { "id": "LA-01-valid", "description": "Well-formed assertion for the registered tuple", "expect": "accepted" },
    { "id": "LA-02-unknown-application", "description": "Application id that maps to no product", "application": "unknown-app", "expect": "unknown_product" },
    { "id": "LA-03-issuer-not-a-product", "description": "iss is a product with no key set", "claims": { "iss": "scheduled" }, "expect": "unknown_product" },
    { "id": "LA-04-issuer-other-product", "description": "iss names another product than the application", "claims": { "iss": "supercharged" }, "expect": "product_mismatch" },
    { "id": "LA-05-alg-hs256", "description": "Header alg is not EdDSA", "header": { "alg": "HS256" }, "expect": "bad_algorithm" },
    { "id": "LA-06-typ-jwt", "description": "Header typ is not titan-link+jwt", "header": { "typ": "JWT" }, "expect": "bad_algorithm" },
    { "id": "LA-07-extra-header-jku", "description": "Unknown header field jku", "header": { "jku": "https://keys.invalid/k.json" }, "expect": "malformed" },
    { "id": "LA-08-missing-kid", "description": "Header has no kid", "header": { "kid": null }, "expect": "malformed" },
    { "id": "LA-09-forbidden-email", "description": "Email claim present", "claims": { "email": "jane@example.com" }, "expect": "forbidden_claim" },
    { "id": "LA-10-forbidden-display-name", "description": "Display name claim present", "claims": { "display_name": "Jane Doe" }, "expect": "forbidden_claim" },
    { "id": "LA-11-wrong-audience", "description": "aud is not titan-central", "claims": { "aud": "titan-other" }, "expect": "wrong_audience" },
    { "id": "LA-12-unknown-kid", "description": "kid not in the product key set", "header": { "kid": "sorted-contract-2099" }, "expect": "unknown_key" },
    { "id": "LA-13-key-after-not-after", "description": "Previous key used after its notAfter", "header": { "kid": "sorted-contract-2026-01" }, "nowSeconds": 1794300000, "claims": { "iat": 1794299990, "exp": 1794300110 }, "expect": "key_inactive" },
    { "id": "LA-14-key-before-not-before", "description": "Current key used before its notBefore", "nowSeconds": 1793400000, "claims": { "iat": 1793399990, "exp": 1793400110 }, "expect": "key_inactive" },
    { "id": "LA-15-wrong-signing-key", "description": "Signed with a key that is not the published one for the kid", "signWith": "attacker", "expect": "bad_signature" },
    { "id": "LA-16-missing-nonce", "description": "Required nonce claim absent", "claims": { "nonce": null }, "expect": "missing_claim" },
    { "id": "LA-17-lifetime-301", "description": "exp - iat is 301 seconds", "claims": { "exp": 1794240301 }, "expect": "bad_lifetime" },
    { "id": "LA-18-lifetime-zero", "description": "exp equals iat", "claims": { "exp": 1794240000 }, "expect": "bad_lifetime" },
    { "id": "LA-19-fractional-iat", "description": "iat is not an integer", "claims": { "iat": 1794240000.5 }, "expect": "bad_lifetime" },
    { "id": "LA-20-future-dated", "description": "iat more than 30 seconds ahead of Central time", "claims": { "iat": 1794240091, "exp": 1794240211 }, "expect": "future_dated" },
    { "id": "LA-21-expired", "description": "Central time is at or after exp", "nowSeconds": 1794240200, "expect": "expired" },
    { "id": "LA-22-identifier-with-at-sign", "description": "lu looks like an email address", "claims": { "lu": "jane.doe@example.com" }, "expect": "identifier_not_permitted" },
    { "id": "LA-23-identifier-with-space", "description": "la looks like a display name", "claims": { "la": "Jane Doe" }, "expect": "identifier_not_permitted" },
    { "id": "LA-24-malformed-nonce", "description": "nonce shorter than 22 characters", "claims": { "nonce": "short" }, "expect": "malformed" },
    { "id": "LA-25-subject-mismatch", "description": "sub differs from Central's record", "claims": { "sub": "usr_otherperson" }, "expect": "subject_mismatch" },
    { "id": "LA-26-organisation-mismatch", "description": "org differs from Central's record", "claims": { "org": "org_zzzz9999" }, "expect": "organisation_mismatch" },
    { "id": "LA-27-account-mismatch", "description": "la differs from the command", "claims": { "la": "sorted-acct-9999" }, "expect": "account_mismatch" },
    { "id": "LA-28-replay", "description": "Same valid assertion presented twice", "verifyTwice": true, "expect": "replayed" },
    { "id": "LA-29-not-a-jws", "description": "Token has no dot separators", "rawToken": "not-a-jws", "expect": "malformed" },
    { "id": "LA-30-oversize-token", "description": "Token longer than 4096 characters", "rawToken": { "repeat": "a", "count": 4097 }, "expect": "malformed" }
  ]
}
