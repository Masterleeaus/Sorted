{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "unresolved": "error",
    "binaries": "error",
    "duplicates": "warn",
    "exports": "warn",
    "types": "warn",
    "nsExports": "warn",
    "nsTypes": "warn",
    "enumMembers": "warn",
    "classMembers": "off"
  },
  "ignoreWorkspaces": [
    "packages/workforce"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.{mjs,ts,js}"
      ],
      "project": [
        "scripts/**/*.{mjs,ts,js}"
      ],
      "ignoreDependencies": [
        "pg"
      ]
    },
    "apps/web": {
      "entry": [
        "public/sw.js",
        "scripts/**/*.mjs"
      ],
      "ignore": [
        "app/app/ZeroChatFirst.tsx",
        "app/app/settings/WorkforceLifecyclePanel.tsx",
        "app/titan/runtime/go-field-runtime.d.mts",
