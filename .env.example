# App
NODE_ENV=development
APP_PORT=3000
APP_BASE_URL=http://localhost:3000

# Client IP for rate limits (login, portal access, booking, intake).
# Number of trusted proxy hops in front of the app that append to X-Forwarded-For.
# 0 (default) = do not trust forwarded headers; all clients then share one
# "unknown" rate-limit bucket. Set this to the verified hop count for your
# deployment. See docs/working/trusted-proxy-client-ip.md.
# TRUSTED_PROXY_COUNT=0

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_fsm
POSTGRES_USER=ai_fsm
# Set the password here or export PGPASSWORD; DATABASE_URL carries no password.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://ai_fsm@localhost:5432/ai_fsm

# Auth
# REQUIRED: Must be at least 32 characters. Generate with: openssl rand -hex 32
AUTH_SECRET=change_me_to_a_long_random_value_that_is_at_least_32_chars

# Public booking
# REQUIRED for /booking submissions. Use the account UUID that should own public intake.
BOOKING_ACCOUNT_ID=00000000-0000-0000-0000-000000000000

# AI (Anthropic) — REQUIRED for AI estimating features.
# The materials generator needs this and fails with a clear "AI not configured"
# message without it. The other AI helpers (SMS classify, scope, review, item
# suggester) silently fall back to rule-based behavior when it is unset, so a
# missing key degrades them quietly. Create a key at console.anthropic.com.
ANTHROPIC_API_KEY=
# Receipt scan/parse model (default: claude-sonnet-4-6 for precision). Use haiku to cut cost.
# RECEIPT_PARSE_MODEL=claude-sonnet-4-6


# Worker
WORKER_POLL_MS=30000

# Email (SMTP) — required for portal magic links
# APP_URL is used in email link generation; defaults to http://localhost:3000
APP_URL=http://localhost:3000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=hello@example.com
SMTP_PASS=your_smtp_password
# SMTP_FROM=Hello <hello@example.com>   # optional, defaults to SMTP_USER

# Secrets at rest (payment-provider tokens, etc.)
# REQUIRED to store Square credentials. Must decode to 32 bytes.
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Square (card payments) — all Square config (token, location/application IDs,
# signature key, and the webhook URL) is managed in the app's Settings →
# Payments page and stored in the database; nothing Square-specific is required
# here. SQUARE_WEBHOOK_URL below is only an optional fallback if the webhook URL
# is left blank in Settings:
# SQUARE_WEBHOOK_URL=https://your-public-host/api/webhooks/square

# Optional storage (future phase)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Web Push (VAPID) — optional. Generate once: npx web-push generate-vapid-keys
# If unset, push is disabled (the app still works). VAPID_SUBJECT is a contact
# mailto:/https: URL required by the push spec.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# Central (identity, service tokens, flags, signed events) — placeholders only.
# Values come from the Central operator. Never commit real values.
# CENTRAL_ORIGIN=https://central.example.invalid
# CENTRAL_OIDC_AUDIENCE=
# CENTRAL_OIDC_CLIENT_ID=
# CENTRAL_OIDC_CLIENT_SECRET=
# CENTRAL_SERVICE_AUDIENCE=
# CENTRAL_SERVICE_CLIENT_ID=
# CENTRAL_SERVICE_CLIENT_SECRET=
# CENTRAL_OUTBOX_SECRET=
# CENTRAL_FLAGS_READ_ENABLED=

# Titan Central account linking (issue #37). Placeholders only; leave empty until
# Central has registered the public key. Values are never committed.
# TITAN_LINK_ISSUER=sorted
# TITAN_LINK_AUDIENCE=titan-central
# TITAN_LINK_KEY_ID=
# TITAN_LINK_PRIVATE_KEY=   # PKCS#8 PEM Ed25519 private key; store in the secret store, not in git

# Titan Central service calls (issue #39). Client secret belongs in the secret store.
# TITAN_CENTRAL_ORIGIN=
# TITAN_CENTRAL_TOKEN_ENDPOINT=
# TITAN_CENTRAL_SERVICE_CLIENT_ID=
# TITAN_CENTRAL_SERVICE_CLIENT_SECRET=
# TITAN_CENTRAL_PRODUCT_AUDIENCE=urn:titan-central:product:sorted
