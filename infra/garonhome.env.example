# Docker Compose project
COMPOSE_PROJECT_NAME=ai-fsm
FSM_DEPLOY_ROOT=/opt/business/ai-fsm
FSM_DATA_ROOT=/opt/business/ai-fsm/data
FSM_ENV_FILE=/opt/business/ai-fsm/env/.env
PROXY_NETWORK=business_proxy

# Backups (see docs/BACKUP_RUNBOOK.md) — passphrase file used to encrypt the
# .env backup; generate with `openssl rand -base64 32`, store the value in the
# password manager, never commit. Defaults to FSM_DEPLOY_ROOT/env/backup.passphrase.
# FSM_BACKUP_PASSPHRASE_FILE=/opt/business/ai-fsm/env/backup.passphrase
# Local backup files are retained for at least seven days; only individually
# verified historical sets are eligible for deletion after a healthy run.
# Backup script writes three mandatory encrypted artifacts and a checksum manifest.
# FSM_BACKUP_DIR=/opt/business/ai-fsm/backups
# Offsite (Google Drive) retention in days. Local retention is fixed at 7 days.
# FSM_BACKUP_REMOTE_RETENTION_DAYS=30
# Alert hook for incomplete backups (unset = no alert sent; see docs/BACKUP_RUNBOOK.md).
# BACKUP_ALERT_CMD=/opt/business/ai-fsm/bin/notify-backup
# Monitoring must also check the status file independently (including missing
# .env or failed source scenarios where this hook cannot be loaded):
#   node scripts/check-backup-health.mjs /opt/business/ai-fsm/backups 26
# Missing/stale/incomplete verified backups return a non-zero exit status.

# App
NODE_ENV=production
APP_PORT=3000
APP_BASE_URL=https://fsm.garonhome.local
BOOKING_ACCOUNT_ID=00000000-0000-0000-0000-000000000000

# Client IP for rate limits. Leave at 0 until the proxy hop count is verified
# (docs/working/trusted-proxy-client-ip.md). 0 = forwarded headers not trusted.
TRUSTED_PROXY_COUNT=0

# Database
POSTGRES_DB=ai_fsm
POSTGRES_USER=ai_fsm
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ai_fsm:change_me@postgres:5432/ai_fsm

# Per-service runtime credentials (ai/INVARIANTS.md, docs/working/rls-web-tier-flip.md).
# DATABASE_URL above is the admin/superuser URL: migrations, provisioning, and scripts.
# compose.garonhome.yml requires WEB_DATABASE_URL and WORKER_DATABASE_URL and
# deploy-garonhome.sh refuses to deploy without them.
#
# Web: keep WEB_DATABASE_URL equal to DATABASE_URL until the web cutover gate clears.
# After the cutover (every sessionless read path sets account context), change it to
# the ai_fsm_web URL below. Provision the role first.
WEB_DATABASE_URL=postgresql://ai_fsm:change_me@postgres:5432/ai_fsm
# AI_FSM_WEB_PASSWORD=change_me_web_role
# WEB_DATABASE_URL=postgresql://ai_fsm_web:change_me_web_role@postgres:5432/ai_fsm
#
# Worker: ai_fsm_worker (BYPASSRLS, DML on RLS tables, no DDL, no superuser). Provision with
#   RUNTIME_DB_ROLE=ai_fsm_worker RUNTIME_DB_PASSWORD=... PROVISION_VIA_COMPOSE=1 \
#   FSM_ENV_FILE=... FSM_COMPOSE_FILE=infra/compose.garonhome.yml bash scripts/db-provision-runtime.sh
AI_FSM_WORKER_PASSWORD=change_me_worker_role
WORKER_DATABASE_URL=postgresql://ai_fsm_worker:change_me_worker_role@postgres:5432/ai_fsm

# Auth
AUTH_SECRET=change_me_to_a_long_random_value_that_is_at_least_32_chars

# Worker
WORKER_POLL_MS=30000

# Location capture (TASK-024): shared secret the Home Assistant bridge sends as
# the x-api-key header to POST /api/internal/location. Generate a random value.
LOCATION_INTERNAL_KEY=
# Optional JSON map HA person/device → users.id for multi-tech presence stamp
# LOCATION_PERSON_MAP={"person.nick":"<user-uuid>","nick":"<user-uuid>"}

# AI (Anthropic) — REQUIRED for AI estimating. Without it the materials
# generator returns a clear "AI not configured" error, and the other AI helpers
# silently fall back to rule-based behavior. Create a key at console.anthropic.com.
ANTHROPIC_API_KEY=

# Secrets at rest (payment-provider tokens, etc.) — REQUIRED before Square can
# be connected. Saving Square credentials throws "APP_ENCRYPTION_KEY is not
# configured" without it. Must decode to 32 bytes.
# Generate with: openssl rand -base64 32
#
# DO NOT CHANGE once set: this key encrypts integration_settings.secrets, so
# rotating it makes already-stored provider secrets undecryptable (they would
# have to be re-entered). Back it up wherever you keep credentials.
APP_ENCRYPTION_KEY=

# Square (card payments) — token, location/application IDs, signature key and
# the webhook URL are all entered in the app (Settings → Square) and stored
# encrypted in the database; nothing Square-specific is required here.
#
# In the Square dashboard, point the webhook at:
#   https://<your-public-host>/api/webhooks/square
# and subscribe to: payment.created, payment.updated, refund.created,
# refund.updated. The URL saved in Settings must match the dashboard exactly —
# signature verification uses it as the notification URL.
#
# SQUARE_WEBHOOK_URL is only an optional fallback used when the webhook URL is
# left blank in Settings:
# SQUARE_WEBHOOK_URL=https://your-public-host/api/webhooks/square

# Optional storage
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
